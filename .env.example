# ---------------------------------------------------------------
# Scroll — Environment Configuration
# Copy this file to .env and fill in your values.
# See README.md for full installation instructions.
# ---------------------------------------------------------------

APP_NAME="Scroll"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------
# Logging
# ---------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------
# Database
# Default: SQLite (quick local setup — no server required)
# For production: switch to mysql and fill in the values below
# ---------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=s_payroll
# DB_USERNAME=your_db_user
# DB_PASSWORD=your_db_password

# ---------------------------------------------------------------
# Session & Cache
# ---------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ---------------------------------------------------------------
# Storage
# Default: local disk
# For production with S3: fill in AWS credentials below
# ---------------------------------------------------------------
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------
# Mail
# Default: log driver (emails written to logs, not sent)
# For production: configure an SMTP provider or Mailgun/SES
# ---------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# Redis (optional — only needed if you switch cache/queue to redis)
# ---------------------------------------------------------------
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ---------------------------------------------------------------
# Demo mode (only enable on public demo environments)
# Set DEMO_MODE=true to activate the nightly-reset demo system.
# ---------------------------------------------------------------
DEMO_MODE=false

# ---------------------------------------------------------------
# Vite
# ---------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# Admin Credentials
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
ADMIN_NAME=YOUR_ADMIN_NAME
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# Supabase Configuration
SUPABASE_ACCESS_KEY_ID=YOUR_SUPABASE_ACCESS_KEY
SUPABASE_SECRET_ACCESS_KEY=YOUR_SUPABASE_SECRET_ACCESS_KEY
SUPABASE_REGION=YOUR_SUPABASE_REGION
SUPABASE_BUCKET=YOUR_SUPABASE_BUCKET_NAME
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ENDPOINT=YOUR_SUPABASE_ENDPOINT_URL
FILESYSTEM_DISK="YOUR_FILESYSTEM_DISK (e.g. supabase)"